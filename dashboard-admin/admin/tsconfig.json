{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./src/*"],
      "@tanstack/react-query": ["./src/lib/tanstack-query.tsx"],
      "@tanstack/react-table": ["./src/lib/tanstack-table.tsx"],
      "@tanstack/react-form": ["./src/lib/tanstack-form.tsx"],
      "zod": ["./src/lib/zod.ts"],
      "use-debounce": ["./src/lib/use-debounce.ts"],
      "date-fns": ["./src/utils/date.ts"],
      "sonner": ["./src/lib/sonner.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
